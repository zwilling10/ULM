<Window x:Class="ULM.Assistant.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="480" MinWidth="480" MinHeight="380"
        Background="{DynamicResource BrushBg}"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Pille statt Rechteck, transparenter Hintergrund statt voller Button-Fläche — für die
             Themen-Vorschläge im Chat (kurzes Chip-Label statt voller Frage als Button-Text). -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBlue}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushCard}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBar}" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrushBlue}"
                        Margin="0,0,12,0">
                    <TextBlock Text="🐧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="HeaderSubtitle" FontSize="11" Foreground="{DynamicResource BrushDim}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── NACHRICHTEN ────────────────────────────────────────────── -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesList" Margin="16,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding BubbleAlignment}"
                                    Margin="0,4" VerticalAlignment="Bottom">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource BrushBlue}"
                                    Visibility="{Binding AvatarVisibility}" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                <TextBlock Text="🐧" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Padding="12,8" CornerRadius="{Binding BubbleCorner}"
                                    Background="{Binding BubbleBrush}" MaxWidth="320">
                                <StackPanel>
                                    <TextBlock Text="{Binding HintText}" FontSize="10.5" FontStyle="Italic"
                                               Foreground="{DynamicResource BrushDim}" Margin="0,0,0,4"
                                               Visibility="{Binding HintVisibility}"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource BrushHeader}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── VORSCHLAG-CHIPS ────────────────────────────────────────── -->
        <WrapPanel x:Name="SuggestionsPanel" Grid.Row="2" Margin="16,0,16,8"/>

        <!-- ── EINGABE ────────────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="18" Margin="0,0,8,0">
                <Grid>
                    <TextBlock x:Name="InputPlaceholder" Margin="14,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource BrushDim}" IsHitTestVisible="False"/>
                    <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0"
                             Padding="14,9" FontSize="12.5" VerticalContentAlignment="Center"
                             KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
                </Grid>
            </Border>

            <Button x:Name="SendButton" Grid.Column="1" Width="36" Height="36" Click="SendButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource BrushBlue}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="→" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</Window>
